wf := import("@platforma-sdk/workflow-tengo:workflow")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")

processTpl := assets.importTemplate(":process")

wf.body(func(args) {
	if is_undefined(args.inputRef) || is_undefined(args.seqCol) || is_undefined(args.countCol) {
		return { outputs: {}, exports: {} }
	}

	blockId := wf.blockId().getDataAsJson()

	anchor := "main"
	bundleBuilder := wf.createPBundleBuilder()
	bundleBuilder.addAnchor(anchor, args.inputRef)
	bundleBuilder.addMulti({
		axes: [{ anchor: anchor, idx: 0 }, { anchor: anchor, idx: 1 }],
		annotations: {
			"pl7.app/isAbundance": "true",
			"pl7.app/abundance/normalized": "false"
		}
	}, "abundanceCols")
	bundleBuilder.addMulti({ axes: [{ anchor: anchor, idx: 1 }] }, "propertyCols")

	result := render.createEphemeral(processTpl, {
		columns: bundleBuilder.build(),
		blockId: blockId,
		seqCol: args.seqCol,
		countCol: args.countCol,
		fullLengthCol: args.fullLengthCol,
		cdr3MinLength: args.cdr3MinLength,
		cdr3MaxLength: args.cdr3MaxLength,
		filterCdr3Length: args.filterCdr3Length,
		cdr1MinLength: args.cdr1MinLength,
		cdr1MaxLength: args.cdr1MaxLength,
		filterCdr1Length: args.filterCdr1Length,
		cdr2MinLength: args.cdr2MinLength,
		cdr2MaxLength: args.cdr2MaxLength,
		filterCdr2Length: args.filterCdr2Length,
		fr1MinLength: args.fr1MinLength,
		fr1MaxLength: args.fr1MaxLength,
		filterfr1Length: args.filterfr1Length,
		fr2MinLength: args.fr2MinLength,
		fr2MaxLength: args.fr2MaxLength,
		filterfr2Length: args.filterfr2Length,
		cdrfr3MinLength: args.fr3MinLength,
		fr3MaxLength: args.fr3MaxLength,
		filterfr3Length: args.filterfr3Length,
		fr4MinLength: args.fr4MinLength,
		fr4MaxLength: args.fr4MaxLength,
		filterfr4Length: args.filterfr4Length,
		fullLengthMinLength: args.fullLengthMinLength,
		fullLengthMaxLength: args.fullLengthMaxLength,
		filterFullLength: args.filterFullLength,
		cdr1Col: args.cdr1Col,
		cdr2Col: args.cdr2Col,
		fr1Col: args.fr1Col,
		fr2Col: args.fr2Col,
		fr3Col: args.fr3Col,
		fr4Col: args.fr4Col,
		maxHd: args.maxHd,
		minRatio: args.minRatio,
		lowerCutoff: args.lowerCutoff
	})

	return {
		outputs: {
			pf: result.output("pf"),
			pythonMessage: result.output("pythonMessage")
		},
		exports: { pf: result.output("pf") }
	}
})

