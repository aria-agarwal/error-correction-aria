{
  "name": "@platforma-sdk/test",
  "version": "1.64.0",
  "description": "Typescript Block Test Helpers",
  "license": "UNLICENSED",
  "files": [
    "dist/**/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@vitest/coverage-istanbul": "^4.1.3",
    "vitest": "^4.1.3",
    "@milaboratories/computable": "2.9.2",
    "@milaboratories/pl-middle-layer": "1.55.8",
    "@platforma-sdk/model": "1.64.0",
    "@milaboratories/pl-client": "3.1.1",
    "@milaboratories/pl-tree": "1.9.9"
  },
  "devDependencies": {
    "@types/node": "~24.5.2",
    "typescript": "~5.9.3",
    "@milaboratories/build-configs": "2.0.0",
    "@milaboratories/ts-builder": "1.3.1",
    "@milaboratories/ts-configs": "1.2.3"
  },
  "scripts": {
    "build": "ts-builder build --target node",
    "watch": "ts-builder build --target node --watch",
    "check": "ts-builder check --target node",
    "formatter:check": "ts-builder formatter --check",
    "linter:check": "ts-builder linter --check",
    "types:check": "ts-builder type-check --target node",
    "test": "vitest run --coverage",
    "do-pack": "rm -f *.tgz && pnpm pack && mv *.tgz package.tgz",
    "fmt": "ts-builder format"
  }
}