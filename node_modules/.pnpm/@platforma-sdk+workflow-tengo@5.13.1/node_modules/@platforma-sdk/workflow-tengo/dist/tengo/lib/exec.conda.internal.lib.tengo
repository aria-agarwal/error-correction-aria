ll := import("@platforma-sdk/workflow-tengo:ll")
validation := import("@platforma-sdk/workflow-tengo:validation")
desc := import("@platforma-sdk/workflow-tengo:exec.descriptor")

condaEnvInputSchema := {
	"condaPackage": validation.reference,
	"condaDescriptor": desc.condaScheme,

	"forceRecreate,?": "number"
}

export ll.toStrict({
	condaEnvInputSchema                     : condaEnvInputSchema
})
