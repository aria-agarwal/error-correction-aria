ll := import("@platforma-sdk/workflow-tengo:ll")
validation := import("@platforma-sdk/workflow-tengo:validation")
desc := import("@platforma-sdk/workflow-tengo:exec.descriptor")

pythonVenvInputSchema := {
	"toolset": "string",
	"dependencies": {"any": validation.reference},


	"pythonDescriptor": desc.runEnvScheme,
	"python": validation.reference,

	"forceRecreate,?": "number"
}

export ll.toStrict({
	pythonVenvInputSchema                       : pythonVenvInputSchema
})
