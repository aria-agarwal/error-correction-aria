

ll := import("@platforma-sdk/workflow-tengo:ll")


TEMPLATE_FIELD := "template"

INPUTS_MAP_FIELD := "inputs"

TEMPLATE_OUTPUT_PREFIX := "outputs/"

PREPARE_MAP_FIELD_NAME := "__prepare__"

export ll.toStrict({
	TEMPLATE_FIELD           : TEMPLATE_FIELD,
	INPUTS_MAP_FIELD         : INPUTS_MAP_FIELD,
	TEMPLATE_OUTPUT_PREFIX   : TEMPLATE_OUTPUT_PREFIX,
	PREPARE_MAP_FIELD_NAME   : PREPARE_MAP_FIELD_NAME
})
