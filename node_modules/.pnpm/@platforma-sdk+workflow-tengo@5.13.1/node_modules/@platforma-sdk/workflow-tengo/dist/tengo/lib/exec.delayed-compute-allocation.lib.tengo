ll := import("@platforma-sdk/workflow-tengo:ll")
render := import("@platforma-sdk/workflow-tengo:render")
smart := import("@platforma-sdk/workflow-tengo:smart")
assets := import("@platforma-sdk/workflow-tengo:assets")
validation := import("@platforma-sdk/workflow-tengo:validation")

tpl := assets.importTemplate("@platforma-sdk/workflow-tengo:exec.delayed-compute-allocation.impl")












create := func(workdir, req) {
	validation.assertType(req, {
		"queue": "string",
		"cpu,?": "number",
		"ram,?": ["or", "number", "string"],
		"gpu,?": "number"
	}, "request must be a valid request")

	reqMap := { queue: req.queue }
	if !is_undefined(req.cpu) {
		reqMap.cpu = req.cpu
	}
	if !is_undefined(req.ram) {
		reqMap.ram = req.ram
	}
	if !is_undefined(req.gpu) && req.gpu > 0 {
		reqMap.gpu = req.gpu
	}

	delayedComputeAllocation := render.createEphemeral(tpl, {
		request: smart.createJsonResource(reqMap),
		wd: workdir
	})
	return delayedComputeAllocation.output("allocation")
}

export ll.toStrict({
	create: create
})
