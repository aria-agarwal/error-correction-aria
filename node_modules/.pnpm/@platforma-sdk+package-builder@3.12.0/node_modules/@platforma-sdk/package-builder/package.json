{
  "name": "@platforma-sdk/package-builder",
  "version": "3.12.0",
  "description": "MiLaboratories Platforma Package builder",
  "keywords": [],
  "license": "UNLICENSED",
  "bin": {
    "pl-pkg": "./bin/run.mjs"
  },
  "files": [
    "bin/run.cmd",
    "bin/run.mjs",
    "dist",
    "assets"
  ],
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.859.0",
    "@aws-sdk/lib-storage": "3.859.0",
    "@oclif/core": "^4.0.37",
    "@types/archiver": "^6.0.3",
    "@types/node": "~24.5.2",
    "archiver": "^7.0.1",
    "undici": "~7.16.0",
    "winston": "^3.17.0",
    "yaml": "^2.8.0",
    "zod": "4.1.12",
    "@milaboratories/resolve-helper": "1.1.3"
  },
  "devDependencies": {
    "@platforma-open/milaboratories.runenv-python-3": "1.7.4",
    "@types/archiver": "^6.0.3",
    "@vitest/coverage-istanbul": "^4.0.18",
    "typescript": "~5.9.3",
    "vite": "8.0.0-beta.15",
    "vitest": "^4.0.18",
    "@milaboratories/build-configs": "1.5.2",
    "@milaboratories/ts-builder": "1.3.0",
    "@milaboratories/ts-configs": "1.2.2",
    "@milaboratories/oclif-index": "1.1.1"
  },
  "oclif": {
    "bin": "pl-pkg",
    "commands": {
      "identifier": "COMMANDS",
      "strategy": "explicit",
      "target": "./dist/index.js"
    },
    "dirname": "pl-pkg",
    "topicSeparator": " "
  },
  "scripts": {
    "build": "oclif-index && node --run fmt && ts-builder build --target node",
    "watch": "ts-builder build --target node --watch",
    "check": "ts-builder check --target node",
    "formatter:check": "ts-builder formatter --check",
    "linter:check": "ts-builder linter --check",
    "types:check": "ts-builder type-check --target node",
    "test": "vitest run --coverage",
    "do-pack": "rm -f *.tgz && pnpm pack && mv *.tgz package.tgz",
    "fmt": "ts-builder format"
  }
}