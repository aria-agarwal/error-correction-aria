{
  "name": "@platforma-sdk/block-tools",
  "version": "2.7.7",
  "description": "Utility to manipulate Platforma Blocks and Block Registry",
  "license": "UNLICENSED",
  "bin": {
    "block-tools": "./bin/run.js"
  },
  "files": [
    "./bin/*",
    "./dist/**/*",
    "./src/**/*",
    "./README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.859.0",
    "@oclif/core": "^4.0.37",
    "canonicalize": "~2.1.0",
    "lru-cache": "^11.2.2",
    "mime-types": "^2.1.35",
    "tar": "^7.4.3",
    "undici": "~7.16.0",
    "yaml": "^2.8.0",
    "zod": "~3.25.76",
    "@milaboratories/pl-http": "1.2.4",
    "@milaboratories/pl-model-middle-layer": "1.16.4",
    "@milaboratories/pl-model-common": "1.31.2",
    "@platforma-sdk/blocks-deps-updater": "2.2.0",
    "@milaboratories/resolve-helper": "1.1.3",
    "@milaboratories/ts-helpers-oclif": "1.1.40",
    "@milaboratories/ts-helpers": "1.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/mime-types": "^2.1.4",
    "@types/node": "~24.5.2",
    "@types/semver": "^7.7.0",
    "@vitest/coverage-istanbul": "^4.1.3",
    "oclif": "^4.16.2",
    "rollup-plugin-node-externals": "^8.0.0",
    "semver": "^7.7.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.6",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.1.3",
    "@milaboratories/build-configs": "2.0.0",
    "@milaboratories/oclif-index": "1.1.1",
    "@milaboratories/ts-builder": "1.3.1",
    "@milaboratories/ts-configs": "1.2.3"
  },
  "oclif": {
    "bin": "block-tools",
    "commands": {
      "identifier": "COMMANDS",
      "strategy": "explicit",
      "target": "./dist/cli.js"
    },
    "dirname": "block-tools",
    "topicSeparator": " "
  },
  "scripts": {
    "oclif:index": "oclif-index --commands-root=./src/cmd/ --index-file=./src/cmd/index.ts && node --run fmt",
    "build": "vite build",
    "readme": "oclif readme",
    "test": "vitest run --coverage",
    "do-pack": "rm -f *.tgz && pnpm pack && mv *.tgz package.tgz",
    "formatter:check": "ts-builder formatter --check",
    "linter:check": "ts-builder linter --check",
    "types:check": "ts-builder type-check --target node",
    "check": "ts-builder check --target node",
    "fmt": "ts-builder format"
  }
}