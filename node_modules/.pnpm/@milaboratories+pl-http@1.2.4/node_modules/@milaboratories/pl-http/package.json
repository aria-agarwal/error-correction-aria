{
  "name": "@milaboratories/pl-http",
  "version": "1.2.4",
  "description": "Common HTTP client settings for Platforma.bio libraries",
  "files": [
    "./dist/**/*",
    "./src/**/*"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "undici": "~7.16.0"
  },
  "devDependencies": {
    "@types/node": "~24.5.2",
    "@vitest/coverage-istanbul": "^4.0.18",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18",
    "@milaboratories/build-configs": "1.5.1",
    "@milaboratories/ts-builder": "1.2.13",
    "@milaboratories/ts-configs": "1.2.2"
  },
  "scripts": {
    "build": "ts-builder build --target node",
    "watch": "ts-builder build --target node --watch",
    "check": "ts-builder check --target node",
    "formatter:check": "ts-builder formatter --check",
    "linter:check": "ts-builder linter --check",
    "types:check": "ts-builder type-check --target node",
    "test": "vitest run --coverage",
    "do-pack": "rm -f *.tgz && pnpm pack && mv *.tgz package.tgz",
    "fmt": "ts-builder format"
  }
}