{
  "name": "@platforma-open/milaboratories.software-small-binaries.hello-world-py",
  "version": "1.0.10",
  "description": "Small 'hello world' on python",
  "block-software": {
    "entrypoints": {
      "main": {
        "binary": {
          "artifact": {
            "registry": "platforma-open",
            "root": "./src",
            "type": "python",
            "environment": "@platforma-open/milaboratories.runenv-python-3:3.12.10-empty",
            "dependencies": {
              "toolset": "pip",
              "requirements": "requirements.txt"
            }
          },
          "cmd": [
            "python",
            "{pkg}/hello.py"
          ]
        }
      }
    }
  },
  "files": [
    "dist/"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@platforma-open/milaboratories.runenv-python-3": "^1.7.5",
    "@platforma-sdk/package-builder": "3.11.6"
  },
  "scripts": {
    "cleanup": "rm -rf ./pkg-*.tgz && rm -rf ./build/ && rm -rf ./dist/",
    "build": "pl-pkg build"
  }
}