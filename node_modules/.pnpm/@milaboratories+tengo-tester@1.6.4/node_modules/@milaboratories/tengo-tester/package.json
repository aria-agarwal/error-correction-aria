{
  "license": "UNLICENSED",
  "name": "@milaboratories/tengo-tester",
  "version": "1.6.4",
  "description": "Binary for running tengo unit tests",
  "author": {
    "email": "support@milaboratories.com",
    "name": "MiLaboratories Inc",
    "url": "https://milaboratories.com/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/lib.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    }
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "bin": {
    "tgo-test": "dist/cmd.js"
  },
  "scripts": {
    "postinstall": "node ./run.cjs ./dist/postinstall.js",
    "build:ts": "tsup",
    "build": "tsup && ./build-multiarch.sh ./cmd/tgo-test tgo-test ./dist",
    "test": "go generate ./internal/tests/ && go test ./internal/..."
  },
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "./run.cjs"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "~20.16.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "tsup": "~8.2.4"
  },
  "tsup": {
    "entry": {
      "lib": "src/lib.ts",
      "cmd": "src/cmd.ts",
      "postinstall": "src/postinstall.ts"
    },
    "shims": true,
    "splitting": false,
    "clean": false,
    "format": [
      "cjs",
      "esm"
    ],
    "dts": true,
    "minify": false,
    "sourcemap": true
  }
}
