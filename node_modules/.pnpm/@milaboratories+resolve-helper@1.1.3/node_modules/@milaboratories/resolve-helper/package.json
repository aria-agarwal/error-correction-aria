{
  "name": "@milaboratories/resolve-helper",
  "version": "1.1.3",
  "description": "Helper functions to resolve packages in a ESM / CJS independent manner",
  "types": "./src/index.d.ts",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "import": "./src/index.mjs"
    }
  },
  "files": [
    "src/**/*"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "~5.9.3",
    "@milaboratories/build-configs": "1.5.1",
    "@milaboratories/ts-configs": "1.2.2"
  },
  "scripts": {}
}