{
  "name": "@platforma-open/milaboratories.software-small-binaries",
  "version": "2.0.4",
  "description": "Small cross-platform binaries for Platforma workflows",
  "block-software": {
    "entrypoints": {
      "hello-world": {
        "reference": "@platforma-open/milaboratories.software-small-binaries.hello-world/dist/tengo/software/main.sw.json"
      },
      "hello-world-py": {
        "reference": "@platforma-open/milaboratories.software-small-binaries.hello-world-py/dist/tengo/software/main.sw.json"
      },
      "mnz-client": {
        "reference": "@platforma-open/milaboratories.software-small-binaries.mnz-client/dist/tengo/software/main.sw.json"
      },
      "table-converter": {
        "reference": "@platforma-open/milaboratories.software-small-binaries.table-converter/dist/tengo/software/main.sw.json"
      }
    }
  },
  "files": [
    "dist/"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@platforma-open/milaboratories.software-small-binaries.hello-world": "1.1.7",
    "@platforma-open/milaboratories.software-small-binaries.mnz-client": "1.6.5",
    "@platforma-open/milaboratories.software-small-binaries.hello-world-py": "1.0.10",
    "@platforma-open/milaboratories.software-small-binaries.table-converter": "1.3.5"
  },
  "devDependencies": {
    "@platforma-sdk/package-builder": "3.11.6"
  },
  "scripts": {
    "cleanup": "rm -rf ./pkg-*.tgz && rm -rf ./dist/",
    "build": "pl-pkg build"
  }
}