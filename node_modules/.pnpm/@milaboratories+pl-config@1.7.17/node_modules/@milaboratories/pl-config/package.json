{
  "name": "@milaboratories/pl-config",
  "version": "1.7.17",
  "description": "MiLaboratories Platforma Backend and Middle Layer config generator",
  "keywords": [],
  "license": "UNLICENSED",
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "README.md",
    "package.json",
    "bin/run.cmd",
    "bin/run.js",
    "assets",
    "postinstall.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "upath": "^2.0.1",
    "yaml": "^2.8.0",
    "@milaboratories/ts-helpers": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "~24.5.2",
    "@vitest/coverage-istanbul": "^4.0.18",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18",
    "@milaboratories/build-configs": "1.5.2",
    "@milaboratories/ts-configs": "1.2.2",
    "@milaboratories/ts-builder": "1.3.0"
  },
  "scripts": {
    "build": "ts-builder build --target node",
    "watch": "ts-builder build --target node --watch",
    "check": "ts-builder check --target node",
    "formatter:check": "ts-builder formatter --check",
    "linter:check": "ts-builder linter --check",
    "types:check": "ts-builder type-check --target node",
    "test": "vitest run --coverage",
    "do-pack": "rm -rf src/.test && rm -f *.tgz && pnpm pack && mv *.tgz package.tgz",
    "fmt": "ts-builder format"
  }
}