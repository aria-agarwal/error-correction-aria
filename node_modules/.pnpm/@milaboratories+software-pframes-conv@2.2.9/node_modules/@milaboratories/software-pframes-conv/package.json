{
  "name": "@milaboratories/software-pframes-conv",
  "version": "2.2.9",
  "description": "PFrames - Converter",
  "files": [
    "dist/"
  ],
  "scripts": {
    "clean": "node scripts/clean",
    "configure": "node scripts/configure",
    "prebuild": "node scripts/clean-dist",
    "build": "node scripts/build",
    "rebuild": "npm run clean && npm run configure && npm run build",
    "test": "node scripts/test",
    "prepublishOnly": "pl-pkg build --all-platforms && pl-pkg prepublish"
  },
  "block-software": {
    "entrypoints": {
      "main": {
        "binary": {
          "artifact": {
            "type": "binary",
            "registry": "milaboratories",
            "roots": {
              "linux-x64": "./bin/pfconv-linux-amd64",
              "linux-aarch64": "./bin/pfconv-linux-arm64",
              "macosx-x64": "./bin/pfconv-macos-amd64",
              "macosx-aarch64": "./bin/pfconv-macos-arm64",
              "windows-x64": "./bin/pfconv-windows-amd64"
            }
          },
          "cmd": [
            "{pkg}/pfconv"
          ]
        },
        "docker": {
          "artifact": {
            "type": "docker",
            "context": "./bin"
          },
          "cmd": [
            "/app/bin/pfconv"
          ]
        }
      }
    }
  },
  "devDependencies": {
    "@platforma-sdk/package-builder": "^3.2.3"
  }
}
