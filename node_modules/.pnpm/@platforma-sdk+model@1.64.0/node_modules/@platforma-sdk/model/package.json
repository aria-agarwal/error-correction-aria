{
  "name": "@platforma-sdk/model",
  "version": "1.64.0",
  "description": "Platforma.bio SDK / Block Model",
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "sources": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./render/internal": {
      "types": "./dist/render/internal.d.ts",
      "sources": "./src/render/internal.ts",
      "import": "./dist/render/internal.js",
      "require": "./dist/render/internal.cjs"
    }
  },
  "dependencies": {
    "canonicalize": "~2.1.0",
    "es-toolkit": "^1.39.10",
    "fast-json-patch": "^3.1.1",
    "utility-types": "^3.11.0",
    "zod": "~3.25.76",
    "@milaboratories/pl-model-middle-layer": "1.16.4",
    "@milaboratories/pl-model-common": "1.31.2",
    "@milaboratories/ptabler-expression-js": "1.2.6",
    "@milaboratories/helpers": "1.14.1",
    "@milaboratories/pl-error-like": "1.12.9"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.1.3",
    "fast-json-patch": "^3.1.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.3",
    "@milaboratories/build-configs": "2.0.0",
    "@milaboratories/pf-driver": "1.3.5",
    "@milaboratories/pf-spec-driver": "1.2.5",
    "@milaboratories/ts-configs": "1.2.3",
    "@milaboratories/ts-builder": "1.3.1"
  },
  "scripts": {
    "build": "ts-builder build --target node",
    "watch": "ts-builder build --target node --watch",
    "check": "ts-builder check --target node",
    "formatter:check": "ts-builder formatter --check",
    "linter:check": "ts-builder linter --check",
    "types:check": "ts-builder type-check --target node",
    "test": "vitest run --coverage",
    "do-pack": "rm -f *.tgz && pnpm pack && mv *.tgz package.tgz",
    "fmt": "ts-builder format"
  }
}