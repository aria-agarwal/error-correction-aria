{
  "name": "@platforma-sdk/tengo-builder",
  "version": "2.5.8",
  "description": "Pl Tengo Template Builder",
  "license": "UNLICENSED",
  "bin": {
    "pl-tengo": "./bin/run.js"
  },
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "README.md"
  ],
  "type": "module",
  "dependencies": {
    "@milaboratories/tengo-tester": "^1.6.4",
    "@oclif/core": "^4.0.37",
    "winston": "^3.17.0",
    "@milaboratories/pl-model-backend": "1.2.8",
    "@milaboratories/ts-helpers": "1.8.1",
    "@milaboratories/resolve-helper": "1.1.3"
  },
  "devDependencies": {
    "@types/node": "~24.5.2",
    "@vitest/coverage-istanbul": "^4.1.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.3",
    "@milaboratories/build-configs": "2.0.0",
    "@milaboratories/oclif-index": "1.1.1",
    "@milaboratories/ts-configs": "1.2.3",
    "@milaboratories/ts-builder": "1.3.1"
  },
  "oclif": {
    "bin": "pl-tengo",
    "commands": {
      "identifier": "COMMANDS",
      "strategy": "explicit",
      "target": "./dist/index.js"
    },
    "dirname": "pl-tengo",
    "topicSeparator": " "
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "oclif-index && node --run fmt && ts-builder build --target node",
    "watch": "ts-builder build --target node --watch",
    "check": "ts-builder check --target node",
    "formatter:check": "ts-builder formatter --check",
    "linter:check": "ts-builder linter --check",
    "types:check": "ts-builder type-check --target node",
    "test": "vitest run --coverage",
    "do-pack": "rm -f *.tgz && pnpm pack && mv *.tgz package.tgz",
    "fmt": "ts-builder format"
  }
}