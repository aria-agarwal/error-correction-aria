{
  "name": "@milaboratories/pl-drivers",
  "version": "1.12.10",
  "description": "Drivers and a low-level clients for log streaming, downloading and uploading files from and to pl",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "~1.13.4",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "@protobuf-ts/plugin": "2.11.1",
    "@protobuf-ts/runtime": "2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "decompress": "^4.2.1",
    "denque": "^2.1.0",
    "openapi-fetch": "^0.15.0",
    "tar-fs": "^3.0.9",
    "undici": "~7.16.0",
    "zod": "~3.25.76",
    "@milaboratories/computable": "2.9.2",
    "@milaboratories/helpers": "1.14.1",
    "@milaboratories/pl-client": "3.1.1",
    "@milaboratories/pl-model-common": "1.31.2",
    "@milaboratories/ts-helpers": "1.8.1",
    "@milaboratories/pl-tree": "1.9.9"
  },
  "devDependencies": {
    "@types/decompress": "^4.2.7",
    "@types/node": "~24.5.2",
    "@types/tar-fs": "^2.0.4",
    "@vitest/coverage-istanbul": "^4.1.3",
    "openapi-typescript": "^7.10.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.3",
    "@milaboratories/build-configs": "2.0.0",
    "@milaboratories/test-helpers": "1.2.1",
    "@milaboratories/ts-builder": "1.3.1",
    "@milaboratories/ts-configs": "1.2.3"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "ts-builder build --target node",
    "check": "ts-builder check --target node",
    "formatter:check": "ts-builder formatter --check",
    "linter:check": "ts-builder linter --check",
    "types:check": "ts-builder type-check --target node",
    "test": "vitest run --coverage",
    "update-proto": "./sync-proto.sh && ./generate-grpc.sh && ./generate-rest.sh",
    "do-pack": "rm -f *.tgz && pnpm pack && mv *.tgz package.tgz",
    "fmt": "ts-builder format"
  }
}