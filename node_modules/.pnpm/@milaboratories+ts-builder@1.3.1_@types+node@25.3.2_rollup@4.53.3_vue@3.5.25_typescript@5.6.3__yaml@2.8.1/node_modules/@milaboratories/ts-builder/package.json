{
  "name": "@milaboratories/ts-builder",
  "version": "1.3.1",
  "description": "TS build tool for the milaboratories packages",
  "bin": {
    "ts-builder": "./bin/ts-builder.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    "./configs/*": "./dist/configs/*"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "commander": "^12.0.0",
    "jsonc-parser": "3.3.1",
    "oxfmt": "0.35.0",
    "oxlint": "1.43.0",
    "rolldown": "^1.0.0-rc.13",
    "rolldown-plugin-dts": "^0.23.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-sourcemaps2": "^0.5.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.6",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue-tsc": "^3.2.6",
    "@milaboratories/ts-configs": "1.2.3"
  },
  "scripts": {
    "build": "rolldown -c",
    "watch": "rolldown -c --watch",
    "do-pack": "rm -f *.tgz && pnpm pack && mv *.tgz package.tgz",
    "check": "oxlint && oxfmt --check && tsc --noEmit",
    "fmt": "oxlint --fix && oxfmt"
  }
}