{
  "name": "@milaboratories/pframes-rs-wasm",
  "version": "1.1.18",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.17.0",
    "@bytecodealliance/preview2-shim": "0.17.8",
    "@milaboratories/build-configs": "1.5.0",
    "@milaboratories/pl-model-common": "1.28.0",
    "@milaboratories/pl-model-middle-layer": "1.15.0",
    "@milaboratories/ts-builder": "1.2.11",
    "@milaboratories/ts-configs": "1.2.1",
    "@types/node": "22.19.13",
    "rimraf": "6.1.3",
    "rollup-plugin-copy": "3.5.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@bytecodealliance/preview2-shim": "0.17.8",
    "@milaboratories/pl-model-common": "1.28.0",
    "@milaboratories/pl-model-middle-layer": "1.15.0"
  },
  "scripts": {
    "bump-version": "cargo run -p pframes_rs_meta --bin npm_version -r --locked",
    "component-transpile": "rimraf src/generated && jco transpile -o src/generated --no-namespaced-exports",
    "patch-disposable": "node scripts/patch-disposable.ts",
    "ts-builder-build": "ts-builder build --target node --build-config build.config.js",
    "build:rust": "cargo build --target wasm32-wasip2",
    "build:ts": "node --run component-transpile -- ../../target/wasm32-wasip2/debug/pframes_rs_wasm.wasm && node --run patch-disposable && node --run ts-builder-build",
    "build": "node --run build:rust && node --run build:ts",
    "postbuild": "rimraf package.tgz && pnpm pack --out package.tgz",
    "ci-build:rust": "node --run build:rust -- -r --locked",
    "ci-build:ts": "node --run component-transpile -- ../../target/wasm32-wasip2/release/pframes_rs_wasm.wasm -O -- -O4 && node --run patch-disposable && node --run ts-builder-build",
    "ci-build": "node --run ci-build:rust && node --run ci-build:ts",
    "postci-build": "node --run postbuild",
    "preci-test": "node --run ci-build",
    "ci-test": "node --run test",
    "pretest": "node --run build",
    "test": "ts-builder type-check --target node --project tsconfig.check.json && pnpm exec vitest run",
    "fix:ts": "ts-builder format",
    "fix": "node --run fix:ts",
    "check:ts": "ts-builder linter --check --target node && ts-builder formatter --check",
    "check": "node --run check:ts"
  }
}